{"CONFIG_VERSION":"3.8","LAST_EDITED_INDEX":14,"APP_TITLE":"Dark Dome","BACKGROUND_URL":"https://treasurehuntsites.github.io/darkdome/Img/Dd1.jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1nE4nEcinfZ6XbhSnpIOJk3VIrKCoXeE&ll=47.428712200000014%2C18.994536600000007&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.433149,"TARGET_LONGITUDE":18.993266,"SUCCESS_REDIRECT_URL":"https://treasurehuntsites.github.io/konyvmegallo/2/game.html","MAP_BUTTON_URL":"https://www.google.com/maps/d/u/0/viewer?mid=19bQljo3HTTLOy2E2cSFPzPbsN9tCK60&ll=47.433149000000014%2C18.993265899999983&z=17","SUCCESS_RADIUS_M":null},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/lidercerdo/Img/oszi.png","§A":"https://treasurehuntsites.github.io/darkdome/Img/lany.jpg","§R":"https://treasurehuntsites.github.io/darkdome/Img/detektiv.png"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":"§N Ren Larsen detektiv egy furcsa kérést kapott.\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§R Mit?! Hogy hozzak vissza az életbe valakit a túlvilágról??\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd2.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Bastiánt elrabolták az árnyékok és átvitték egy másik világba.\n\n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd3.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Csak két nyomunk van amin elindulhatunk.\n\n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd4.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Bastián gyerek korában elátkozták az erdőben egy elhagyatott kunyhóban, de fogalmam sincs hol.\n\n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd4.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Bastián gyerek korában elátkozták az erdőben egy elhagyatott kunyhóban, de fogalmam sincs hol.\n\n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd4.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A A második nyom: \n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd5.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Most a túlvilágon van, amit úgy hiívnak, hogy \"Penumbra\".\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A De abszolút semmit sem tudok erről a helyről.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§R Ami biztos, hogy ha nem tér vissza mielőbb...\n","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd6.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Akkor örökké az árnyékvilágban marad.","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd6.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Nem tudom, hogy hol van az a kunyhó.","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd7.png","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Lehet, hogy érdemes lenne Bastián házánál elkezdeni a kutatást.","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd7.png","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Ez a ház már egy ideje elhagyatott, de minden ugyan úgy van hagyva, mint annak idején.","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/Dd8.jpg","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Hát, akkor lássunk neki.","customAvatarUrl":"","customBackgroundUrl":"https://treasurehuntsites.github.io/darkdome/Img/detektiv2.jpg","customGalleryUrl":"","galleryMode":"add_url"}],"MEDIA":{"AUDIO_1_URL":"Img/audio1.mp3","AUDIO_2_URL":"Img/audio2.mp3"},"LAST_GALLERY_ADD_INDEX":0}