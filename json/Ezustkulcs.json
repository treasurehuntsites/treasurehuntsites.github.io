      "nextPageId": "scream-3",
      "rewards": [],
      "hiddenItems": [],
      "hints": ""
    },
    {
      "id": "scream-3",
      "content": "§N \"Ébren van!\" \"Mi?\" \"Üsd ki újra! Gyorsan!\"",
