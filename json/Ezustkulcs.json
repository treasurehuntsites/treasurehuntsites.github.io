      "nextPageId": "arrival-1",
      "rewards": [],
      "hiddenItems": [],
      "hints": ""
    },
    {
      "id": "arrival-1",
      "content": "§N A férfiak óvatosan kiemelnek a kocsiból, és egy olyan helyre viszik, ami melegebb, mint a kinti.",
