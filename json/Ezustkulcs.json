      "nextPageId": "scream-5",
      "rewards": [],
      "hiddenItems": [],
      "hints": ""
    },
    {
      "id": "scream-5",
      "content": "§N Az előtted álló férfi erőlködve felnyög, mintha emelne valamit.",
      "pageType": "story",
      "nextPageId": "scream-6",
      "rewards": [],
      "hiddenItems": [],
      "hints": ""
    },
    {
      "id": "scream-6",
      "content": "§N Rossz előérzettel fordulsz előre, pero már túl késő.",
      "pageType": "story",
      "nextPageId": "scream-7",
      "rewards": [],
      "hiddenItems": [],
      "hints": ""
    },
    {
      "id": "scream-7",
      "content": "§N Érzed, hogy valami kemény és nehéz csapódik a fejedbe, és minden elhalványul.",
