    {
      "id": "a81794b4-db15-4d24-870c-774cd285e3c6",
      "content": "§B Are you serious?",
      "pageType": "story",
      "rewards": [{ "icon": "📦", "url": "https://treasurehuntsites.github.io/titkokkora/Img/konyvtar.jpg", "name": "Library" }]
    },
    {
      "id": "23986ec2-afed-4700-ab91-066fa2ec2b34",
      "content": "§B Where?",
      "pageType": "story",
