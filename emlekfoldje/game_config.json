  "storyPages": [
    {
      "pageContent": "§R Nevem Dr. Aris Thorne. Évek óta kutatom az 'Emlék Földje' nevű várost. Most végre itt állok a kapuban. A csend szinte fáj.",
      "pageType": "text",
      "imageUrl": "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1080&auto=format&fit=crop",
      "nextIndex": 1,
      "audioUrl": "",
      "password": "",
      "choices": []
    },
    {
      "pageContent": "§N Ahogy átlépsz a rozsdás vaskapun, az hatalmas dörejjel becsapódik mögötted. Nincs visszaút.\n\n§R Csapdába estem... De mi ez a suttogás a fejemben?",
      "pageType": "text",
      "imageUrl": "https://images.unsplash.com/photo-1444491741275-3747c53c99b4?q=80&w=1080&auto=format&fit=crop",
      "nextIndex": 2,
      "audioUrl": "",
      "password": "",
      "choices": []
    },
    {
      "pageContent": "§N Egy elágazáshoz érsz. Balra egy düledező fogadó, jobbra egy órakészítő műhely sötétlik.",
      "pageType": "choice",
      "imageUrl": "https://images.unsplash.com/photo-1505832018823-50331d70d237?q=80&w=1080&auto=format&fit=crop",
      "choices": [
        { "text": "Irány a fogadó", "nextIndex": 3 },
        { "text": "Az órakészítőhöz megyek", "nextIndex": 4 }
      ],
      "nextIndex": 0,
      "audioUrl": "",
      "password": ""
    },
    {
      "pageContent": "§A Nézd azt a régi pénztárgépet a pulton! Poros, de mintha működne. Valamilyen évszám kell hozzá (1924).",
      "pageType": "password",
      "imageUrl": "https://images.unsplash.com/photo-1508615039623-a25605d2b022?q=80&w=1080&auto=format&fit=crop",
      "password": "1924",
      "nextIndex": 5,
      "audioUrl": "",
      "choices": []
    },
    {
      "pageContent": "§N A műhelyben ezer óra ketyeg egyszerre, mégis áll az idő. A toronyóra mutatói hiányoznak.\n\n§R Meg kell találnom az alkatrészeket!",
      "pageType": "text",
      "imageUrl": "https://images.unsplash.com/photo-1509048191080-d2984bad6ad5?q=80&w=1080&auto=format&fit=crop",
      "nextIndex": 5,
      "audioUrl": "",
      "password": "",
      "choices": []
    },
    {
      "pageContent": "§R Megvan minden nyom. Most már csak az Emlékkertbe kell eljutnom, hogy megtörjem az átkot.\n\n§N Használd a GPS-t a továbbhaladáshoz!",
      "pageType": "text",
      "imageUrl": "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=1080&auto=format&fit=crop",
      "nextIndex": -1,
