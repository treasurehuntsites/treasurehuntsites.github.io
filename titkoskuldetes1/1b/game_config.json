{"CONFIG_VERSION":"3.8","LAST_EDITED_INDEX":18,"APP_TITLE":"Titkos Küldetés - Telefonfülke","BACKGROUND_URL":"https://treasurehuntsites.github.io/titkoskuldetes1/1/Img/1757442206 (1).jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1qTBS42KcRDJRlwSLY1FUDSbAwHxP3wo&ll=47.426209499999985%2C19.038944499999992&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.42806,"TARGET_LONGITUDE":19.03658,"SUCCESS_REDIRECT_URL":"https://treasurehuntsites.github.io/titkoskuldetes1/2/game.html","MAP_BUTTON_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1jaaxNriWkeGPzFJC4e--k0CU2QyBFx8&ll=47.42897251754386%2C19.034298274450695&z=14"},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/annaesmark/Img/mark.png","§A":"https://treasurehuntsites.github.io/annaesmark/Img/anna.png","§R":"https://placehold.co/70x70/1A1A1A/00FF00?text=R"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":"§N Egy sötét, nyirkos estén, a város zajától nem messze, két titkos ügynök, Anna és Márk, egy telefonfülkében várakozott.\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1757442206 (1).jpg","galleryMode":"add_url"},{"type":"text","content":"§N Anna türelmetlenül dobolt az ujjaival az üvegfalon.\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1757442206 (1).jpg","galleryMode":"add_url"},{"type":"text","content":"§A Biztos, hogy ez az a fülke?\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Már húsz perce itt állunk, és semmi.\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Türelem, Anna.\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Ha a kontaktunk nem tévedett, akkor itt kapjuk meg az első nyomot.\n\n\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Ahogy Márk befejezte a mondatot, Anna észrevett egy furcsa tárgyat a fülkében.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Nézd Márk, mi lehet ez? Mi van, ha megnyomom?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"audio","content":"§N \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url","audioId":1},{"type":"audio","content":"§N \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url","audioId":2},{"type":"text","content":"§M Egy üvegkapszulát?\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Ez valami rejtvény!\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Már meg is van!\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Itt volt pont a fejünk felett mágnessel rögzítve.\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Néhány perc múlva Márk talált egy kis üvegkapszulát.\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Mikor kinyitotta a tetejét, egy összetekert papírt húzott ki belőle.\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Ezaz!\n\n\n\n\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M De mihez vezet?\n\n\n\n\n\n\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"password","content":"§N","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1757454039.jpg","galleryMode":"add_url","correctPassword":"5571","nextIndexSuccess":-1,"helpMessage":["A fejed felett keresgélj","Apró üvegcse","5571"]}],"MEDIA":{"AUDIO_1_URL":"https://treasurehuntsites.github.io/media/Ugynokok1.mp3","AUDIO_2_URL":"https://treasurehuntsites.github.io/media/Ugynokok2.mp3"}}