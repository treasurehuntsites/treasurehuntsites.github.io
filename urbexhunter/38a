<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Urbex Hunter v9 - Final Map Fix</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { 
            getAuth, signInWithPopup, GoogleAuthProvider, onAuthStateChanged, signInAnonymously, signInWithCustomToken, signOut 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { 
            getFirestore, doc, setDoc, getDoc, collection, onSnapshot, updateDoc, arrayUnion, arrayRemove, increment, query, deleteDoc
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const firebaseConfig = typeof __firebase_config !== 'undefined' 
            ? JSON.parse(__firebase_config) 
            : {
                apiKey: "AIzaSyCE9HsgnhCbjGWkRUSYeWblSAJAj9Y-3lk",
                authDomain: "urbex-hunter.firebaseapp.com",
                projectId: "urbex-hunter",
                storageBucket: "urbex-hunter.firebasestorage.app",
                messagingSenderId: "23703144828",
                appId: "1:23703144828:web:016a96cd6c1fe01ab5fcf9",
                measurementId: "G-NWN15EC2RW"
            };

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'urbex-hunter-v9'; 
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const googleProvider = new GoogleAuthProvider();

        const ADMIN_EMAIL = "jatszmabunker@gmail.com";

        const LEVELS = [
            { min: 0, name: "Zöldfülű", color: "text-gray-400" },
            { min: 100, name: "Vándor", color: "text-blue-400" },
            { min: 500, name: "Alpinista", color: "text-purple-400" }
        ];

        const CATEGORIES = [
            { id: 'bunker', name: 'Bunker', icon: '🛡️' },
            { id: 'crane', name: 'Daru', icon: '🏗️' },
            { id: 'sanatorium', name: 'Szanatórium', icon: '🏥' },
            { id: 'hospital', name: 'Kórház', icon: '🚑' },
            { id: 'industrial', name: 'Ipari', icon: '🏭' },
            { id: 'facility', name: 'Létesítmény', icon: '🏢' },
            { id: 'residential', name: 'Lakóépület', icon: '🏚️' },
            { id: 'other', name: 'Egyéb', icon: '📍' }
        ];

        let user = null;
        let userData = { score: 0, groups: [], visited: [], username: "" };
        let locations = [];
        let allGroups = [];
        let allApplications = []; 
        let myGroupIds = []; 
        let publicProfiles = {}; 
        let map = null;
        let markers = [];
        let userMarker = null; 
        let lastTrackedPos = null;
        let activeLocationId = null; 
        let isChecking = false;
        let unsubscribeList = [];
        let qrScanner = null;
        let groupFilter = 'all';

        const getLevelInfo = (score) => LEVELS.slice().reverse().find(l => score >= l.min) || LEVELS[0];

        const showMessage = (text, type = 'info') => {
            const box = document.getElementById('message-box');
            box.innerText = text;
            box.className = `fixed top-4 left-1/2 -translate-x-1/2 p-4 rounded shadow-2xl z-[10000] text-white font-bold text-center text-xs transition-all ${type === 'error' ? 'bg-red-600' : 'bg-green-600'}`;
            box.classList.remove('hidden');
            setTimeout(() => box.classList.add('hidden'), 4000);
        };

        const updateNavVisibility = () => {
            const loginSection = document.getElementById('nav-login-section');
            const logoutSection = document.getElementById('nav-logout-section');
            const checkinBtn = document.getElementById('checkin-btn-outer');

            if (document.getElementById('view-location-info').classList.contains('hidden') === false) {
                if(checkinBtn) checkinBtn.classList.remove('hidden');
                if(loginSection) loginSection.classList.add('hidden');
                if(logoutSection) logoutSection.classList.add('hidden');
            } else {
                if(checkinBtn) checkinBtn.classList.add('hidden');
                if (user) {
                    if(loginSection) loginSection.classList.add('hidden');
                    if(logoutSection) logoutSection.classList.remove('hidden');
                } else {
                    if(loginSection) loginSection.classList.remove('hidden');
                    if(logoutSection) logoutSection.classList.add('hidden');
                }
            }
        };

        window.showView = (viewId) => {
            document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
            document.getElementById(viewId).classList.remove('hidden');
            updateNavVisibility();
            if (viewId === 'view-map' && map) setTimeout(() => map.invalidateSize(), 100);
            if (viewId === 'view-groups') renderGroups();
        };

        const initMap = () => {
            if (map) return;
            map = L.map('map-container', { zoomControl: false, attributionControl: false }).setView([47.4979, 19.0402], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png').addTo(map);
            
            map.on('click', (e) => {
                if (!user) return showMessage("Lépj be a rögzítéshez!", "error");
                if (myGroupIds.length === 0 && user.email !== ADMIN_EMAIL) return showMessage("Csatlakozz egy klánhoz!", "error");
                
                const lat = e.latlng.lat;
                const lng = e.latlng.lng;
                document.getElementById('lat-val').innerText = lat.toFixed(5);
                document.getElementById('lng-val').innerText = lng.toFixed(5);
                window.selectedCoords = e.latlng;

                const myGroups = allGroups.filter(g => myGroupIds.includes(g.id));
                document.getElementById('loc-group-select').innerHTML = myGroups.map(g => `<option value="${g.id}">${g.name}</option>`).join('');
                document.getElementById('loc-category-select').innerHTML = CATEGORIES.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
                
                window.showView('view-add');
            });
            
            setTimeout(() => map.invalidateSize(), 500);
        };

        window.loginWithGoogle = async () => {
            try {
                await signInWithPopup(auth, googleProvider);
            } catch (e) {
                console.error("Popup hiba:", e);
                showMessage("Belépés névtelenül...", "info");
                await signInAnonymously(auth);
            }
        };

        window.logout = () => signOut(auth).then(() => location.reload());

        const handleAuthChange = async (u) => {
            user = u;
            unsubscribeList.forEach(unsub => unsub());
            unsubscribeList = [];
            updateNavVisibility();
            if (u) {
                document.getElementById('profile-area').classList.remove('hidden');
                const userRef = doc(db, 'artifacts', appId, 'users', u.uid, 'profile', 'data');
                const snap = await getDoc(userRef);
                if (!snap.exists() || !snap.data().username) document.getElementById('name-setup-modal').classList.remove('hidden');
                setupListeners();
            } else { 
                document.getElementById('profile-area').classList.add('hidden'); 
            }
        };

        const setupListeners = () => {
            if (!user) return;
            unsubscribeList.push(onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'profiles'), snap => {
                snap.docs.forEach(d => publicProfiles[d.id] = d.data());
            }));
            unsubscribeList.push(onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'groups'), snap => {
                allGroups = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                myGroupIds = allGroups.filter(g => g.members?.includes(user.uid)).map(g => g.id);
                renderGroups();
                updateMarkers();
            }));
            unsubscribeList.push(onSnapshot(doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'data'), snap => {
                userData = snap.data() || { score: 0, groups: [], visited: [], username: "" };
                updateUI();
                updateMarkers();
            }));
            unsubscribeList.push(onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'locations'), snap => {
                locations = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                updateMarkers();
            }));
        };

        const updateUI = () => {
            const info = getLevelInfo(userData.score || 0);
            document.getElementById('user-score').innerText = userData.score || 0;
            document.getElementById('user-level').innerText = info.name;
            document.getElementById('profile-name').innerText = userData.username || "Hunter";
        };

        window.finishNameSetup = async () => {
            const name = document.getElementById('new-user-username').value.trim();
            if (!name || name.length < 3) return showMessage("Túl rövid név!", "error");
            try {
                await setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'data'), { username: name, score: 0, groups: [], visited: [], createdAt: Date.now() }, { merge: true });
                await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'profiles', user.uid), { username: name, score: 0 }, { merge: true });
                document.getElementById('name-setup-modal').classList.add('hidden');
                showMessage("Üdv, " + name + "!");
            } catch (e) { showMessage("Szerver hiba", "error"); }
        };

        const updateMarkers = () => {
            if (!map) return;
            markers.forEach(m => m.remove());
            markers = [];
            const visibleLocations = locations.filter(loc => myGroupIds.includes(loc.groupId));
            visibleLocations.forEach(loc => {
                let color = '#3b82f6'; 
                if (userData.visited?.includes(loc.id)) color = '#6b7280'; 
                else if (loc.status === 'active') color = loc.installed ? '#22c55e' : '#f97316'; 
                
                const cat = CATEGORIES.find(c => c.id === (loc.categoryId || 'other')) || CATEGORIES[7];
                
                const pinIcon = L.divIcon({
                    className: 'custom-pin-icon',
                    html: `<div class="pin-wrapper" style="--pin-color: ${color}">
                            <svg class="pin-svg" viewBox="0 0 34 44"><path d="M17 0C7.61 0 0 7.61 0 17C0 29.75 17 44 17 44C17 44 34 29.75 34 17C34 7.61 26.39 0 17 0Z" fill="currentColor"/></svg>
                            <div class="pin-inner-white"></div>
                            <span class="pin-emoji-content">${cat.icon}</span>
                        </div>`,
                    iconSize: [36, 46], iconAnchor: [18, 46]
                });
                const marker = L.marker([loc.lat, loc.lng], { icon: pinIcon }).addTo(map);
                marker.on('click', () => window.showLocationDetail(loc.id));
                markers.push(marker);
            });
        };

        window.showLocationDetail = (locId) => {
            const loc = locations.find(l => l.id === locId); if (!loc) return;
            activeLocationId = locId;
            const cat = CATEGORIES.find(c => c.id === (loc.categoryId || 'other')) || CATEGORIES[7];
            document.getElementById('info-title').innerText = loc.name;
            document.getElementById('info-category').innerText = `${cat.icon} ${cat.name}`;
            document.getElementById('info-pts').innerText = loc.status === 'active' ? (loc.finalPoints || 0) + ' PTS' : 'Szavazás alatt';
            document.getElementById('info-approach').innerText = loc.approach || 'Nincs leírás.';
            const actionContainer = document.getElementById('info-action-container');
            actionContainer.innerHTML = '';
            if (loc.status === 'voting') {
                actionContainer.innerHTML = `<div class="grid grid-cols-4 gap-2">${[10, 50, 100, 200].map(v => `<button onclick="window.voteValue('${loc.id}', ${v})" class="py-2 border border-gray-700 rounded-xl text-blue-400 font-bold bg-gray-900">${v}</button>`).join('')}</div>`;
            }
            window.showView('view-location-info');
        };

        window.handleAction = async () => {
            const loc = locations.find(l => l.id === activeLocationId); if (!loc || isChecking) return;
            if (!lastTrackedPos) return showMessage("Várj a GPS jelre!", "error");
            
            const R = 6371e3;
            const lat1 = lastTrackedPos.lat * Math.PI/180, lat2 = loc.lat * Math.PI/180;
            const dLat = (loc.lat - lastTrackedPos.lat) * Math.PI/180, dLon = (loc.lng - lastTrackedPos.lng) * Math.PI/180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon/2) * Math.sin(dLon/2);
            const dist = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

            if (dist > 60 && user.email !== ADMIN_EMAIL) return showMessage(`Túl messze vagy! (${Math.round(dist)}m)`, "error");
            
            isChecking = true;
            try {
                const userRef = doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'data');
                if (!loc.installed) {
                    if (loc.creatorId !== user.uid) { showMessage("Csak a beküldő aktiválhatja!", "error"); isChecking = false; return; }
                    await updateDoc(userRef, { score: increment(loc.finalPoints || 50), visited: arrayUnion(loc.id) });
                    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'locations', loc.id), { installed: true });
                    showMessage("Aktiválva!");
                } else {
                    if (userData.visited?.includes(loc.id)) { showMessage("Már voltál itt!"); isChecking = false; return; }
                    await updateDoc(userRef, { score: increment(Math.round((loc.finalPoints || 50)/2)), visited: arrayUnion(loc.id) });
                    showMessage("Igazolva!");
                }
                window.showView('view-map');
            } catch (e) { showMessage("Mentési hiba", "error"); } finally { isChecking = false; }
        };

        window.voteValue = async (locId, val) => {
            const locRef = doc(db, 'artifacts', appId, 'public', 'data', 'locations', locId);
            const snap = await getDoc(locRef); const d = snap.data();
            if (d.voters?.includes(user.uid)) return showMessage("Már szavaztál!");
            const nT = (d.voteTotal || 0) + val, nC = (d.voteCount || 0) + 1;
            let up = { voteTotal: nT, voteCount: nC, voters: arrayUnion(user.uid) };
            if (nC >= 10) { 
                const avg = Math.round(nT/nC); 
                up.status = 'active'; 
                up.finalPoints = avg; 
                up.requiredLevelIndex = avg > 200 ? 1 : 0; 
            }
            await updateDoc(locRef, up); showMessage("Sikeres szavazat!"); window.showView('view-map');
        };

        window.toggleGroupForm = () => document.getElementById('create-group-box').classList.toggle('hidden');

        window.createGroup = async () => {
            const name = document.getElementById('new-group-name').value.trim();
            if (!name) return;
            const id = "GRP-" + Math.random().toString(36).substring(2, 8).toUpperCase();
            try {
                await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'groups', id), { id, name, creatorId: user.uid, members: [user.uid], totalScore: userData.score || 0, requiredLevelIndex: 0 });
                await updateDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'data'), { groups: arrayUnion(id) });
                showMessage("Klán alapítva!"); window.toggleGroupForm();
            } catch (e) { showMessage("Hiba", "error"); }
        };

        window.applyToGroup = async (gid) => {
            const g = allGroups.find(x => x.id === gid);
            await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'applications', `APP-${user.uid}-${gid}`), { id: `APP-${user.uid}-${gid}`, groupId: gid, userId: user.uid, username: userData.username, creatorId: g.creatorId });
            showMessage("Jelentkezés elküldve!");
        };

        const renderGroups = () => {
            const c = document.getElementById('group-list');
            c.innerHTML = allGroups.map(g => {
                const isM = myGroupIds.includes(g.id);
                return `<div class="bg-gray-800 p-4 rounded-2xl border border-gray-700 mb-2 flex justify-between items-center"><div><h4 class="font-bold text-white uppercase">${g.name}</h4><p class="text-[8px] text-gray-500 font-bold">${g.members?.length || 0} TAG</p></div>${isM ? '<span class="text-[9px] text-green-500 font-bold">TAG</span>' : `<button onclick="window.applyToGroup('${g.id}')" class="bg-blue-600 px-3 py-1 rounded-lg text-[10px] font-bold">BELÉPÉS</button>`}</div>`;
            }).join('');
        };

        window.recenterMap = () => {
            if (lastTrackedPos) map.setView([lastTrackedPos.lat, lastTrackedPos.lng], 16);
        };

        window.toggleFullscreen = () => {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else document.exitFullscreen();
        };

        // Név megjelenítés logika
        const setupNameReveal = () => {
            const scoreArea = document.getElementById('score-reveal-area');
            const nameLabel = document.getElementById('profile-name');
            const show = () => nameLabel.classList.remove('opacity-0');
            const hide = () => nameLabel.classList.add('opacity-0');
            scoreArea.addEventListener('mousedown', show);
            scoreArea.addEventListener('mouseup', hide);
            scoreArea.addEventListener('touchstart', (e) => { e.preventDefault(); show(); });
            scoreArea.addEventListener('touchend', hide);
        };

        // Inicializálás
        window.addEventListener('DOMContentLoaded', () => {
            initMap();
            trackUserPosition();
            setupNameReveal();
            
            if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                signInWithCustomToken(auth, __initial_auth_token).catch(() => {});
            }
            onAuthStateChanged(auth, handleAuthChange);
        });

        window.saveLocation = async (e) => {
            e.preventDefault();
            const name = document.getElementById('loc-name').value;
            const gid = document.getElementById('loc-group-select').value;
            const cid = document.getElementById('loc-category-select').value;
            const appr = document.getElementById('loc-approach').value;
            const id = "LOC-" + Math.random().toString(36).substring(2, 10).toUpperCase();
            
            try {
                await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'locations', id), {
                    id, name, groupId: gid, categoryId: cid, approach: appr,
                    lat: window.selectedCoords.lat, lng: window.selectedCoords.lng,
                    installed: false, creatorId: user.uid, creatorName: userData.username,
                    voteCount: 0, voteTotal: 0, voters: [], status: 'voting', createdAt: Date.now()
                });
                showMessage("Beküldve szavazásra!");
                window.showView('view-map');
            } catch(e) { showMessage("Hiba a mentésnél", "error"); }
        };

    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');
        body { font-family: 'Space Mono', monospace; background: #050505; color: #eee; -webkit-tap-highlight-color: transparent; overflow: hidden; }
        
        #view-map { position: fixed; inset: 0; padding-bottom: 5rem; z-index: 10; }
        #map-container { width: 100%; height: 100%; z-index: 1; }
        
        /* PIN STYLING */
        .pin-wrapper { position: relative; width: 36px; height: 46px; display: flex; align-items: center; justify-content: center; color: var(--pin-color); }
        .pin-svg { position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 4px 5px rgba(0,0,0,0.4)); }
        .pin-inner-white { position: absolute; top: 18px; left: 50%; transform: translate(-50%, -50%); width: 22px; height: 22px; background: white; border-radius: 50%; z-index: 5; }
        .pin-emoji-content { position: absolute; top: 18px; left: 50%; transform: translate(-50%, -50%); font-size: 15px; z-index: 10; line-height: 1; pointer-events: none; }
        .custom-pin-icon { background: none !important; border: none !important; }

        .map-ctrl { position: absolute; right: 1rem; width: 44px; height: 44px; background: rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; display: flex; items-center: center; justify-content: center; z-index: 100; backdrop-filter: blur(5px); }
        #recenter-btn { bottom: 7rem; } #fullscreen-btn { bottom: 10.5rem; }
        
        .player-pulse { animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
        
        .profile-pulse { animation: soft-pulse 4s infinite; }
        @keyframes soft-pulse { 0% { opacity: 0.8; } 50% { opacity: 1; } 100% { opacity: 0.8; } }
        
        .view { height: 100vh; overflow-y: auto; padding-bottom: 6rem; position: relative; z-index: 20; background: #050505; }
        #view-map.view { background: transparent; overflow: hidden; }
        
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body>
    <div id="message-box" class="hidden"></div>

    <div id="name-setup-modal" class="fixed inset-0 bg-black z-[9000] flex items-center justify-center p-6 hidden">
        <div class="bg-gray-900 w-full max-w-sm rounded-[2.5rem] border border-blue-600/30 p-8 shadow-2xl">
            <h2 class="text-xl font-bold text-white mb-2 uppercase italic">Üdvözlünk!</h2>
            <p class="text-[10px] text-gray-400 font-bold uppercase mb-6">Adj meg egy nevet. Később nem módosíthatod!</p>
            <input id="new-user-username" type="text" placeholder="Neved..." class="w-full p-4 rounded-xl text-sm mb-6 bg-black border border-gray-800 text-white outline-none">
            <button onclick="window.finishNameSetup()" class="w-full bg-blue-600 text-white font-bold py-4 rounded-xl text-[10px] uppercase tracking-widest">Kezdés</button>
        </div>
    </div>

    <header class="p-3 px-6 border-b border-gray-800 bg-black/80 backdrop-blur-md sticky top-0 z-[5000]">
        <div class="flex justify-between items-center max-w-xl mx-auto">
            <div>
                <h1 class="text-md font-bold text-green-500 uppercase italic leading-none">Urbex Hunter <span class="text-[8px] text-gray-500">v9</span></h1>
                <p id="user-level" class="text-[8px] text-gray-500 font-bold uppercase">Betöltés...</p>
            </div>
            <div id="profile-area" class="hidden text-right flex flex-col items-end">
                <p id="profile-name" class="text-[9px] font-bold text-white mb-0 uppercase opacity-0 transition-opacity">Hunter</p>
                <div id="score-reveal-area" class="bg-green-900/20 border border-green-500/20 px-3 py-1 rounded-xl mt-1 profile-pulse cursor-pointer select-none">
                    <p class="text-green-500 font-bold text-2xl tracking-tighter leading-none"><span id="user-score">0</span></p>
                </div>
            </div>
        </div>
    </header>

    <main>
        <!-- TÉRKÉP -->
        <div id="view-map" class="view">
            <div id="map-container"></div>
            <button id="recenter-btn" onclick="window.recenterMap()" class="map-ctrl">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v2m0 16v2m10-10h-2M4 12H2"/></svg>
            </button>
            <button id="fullscreen-btn" onclick="window.toggleFullscreen()" class="map-ctrl">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            </button>
        </div>

        <!-- KLÁNOK -->
        <div id="view-groups" class="view hidden p-4 max-w-xl mx-auto">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-lg font-bold text-blue-500 uppercase italic">Klánok</h2>
                <button onclick="window.toggleGroupForm()" class="bg-blue-600 text-white text-[9px] font-bold px-4 py-2 rounded-xl">ÚJ KLÁN</button>
            </div>
            <div id="create-group-box" class="hidden mb-6 p-6 bg-gray-900 rounded-3xl border border-blue-600/30 shadow-2xl">
                <input id="new-group-name" type="text" placeholder="Klán neve" class="w-full p-4 rounded-xl text-xs mb-4 bg-black border border-gray-800 text-white outline-none font-bold uppercase">
                <button onclick="window.createGroup()" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl text-[10px] uppercase tracking-widest">Létrehozás</button>
            </div>
            <div id="group-list" class="space-y-1"></div>
        </div>

        <!-- HELYSZÍN INFÓ -->
        <div id="view-location-info" class="view hidden p-6 max-w-xl mx-auto">
            <button onclick="window.showView('view-map')" class="text-[10px] text-green-500 font-bold mb-8 uppercase tracking-widest">← Vissza</button>
            <h2 id="info-title" class="text-3xl font-bold text-white uppercase italic leading-none mb-1">Hely</h2>
            <p id="info-category" class="text-xs font-bold text-blue-400 uppercase mb-6 tracking-widest">Típus</p>
            <div class="bg-gray-900 p-4 rounded-2xl mb-6 border border-gray-800"><p id="info-pts" class="text-2xl font-bold text-green-500 leading-none">0 PTS</p></div>
            <div class="bg-gray-900 p-6 rounded-3xl border border-gray-800 mb-6">
                <p class="text-[10px] text-gray-500 uppercase font-bold mb-2 tracking-widest">Leírás</p>
                <p id="info-approach" class="text-sm text-gray-300 leading-relaxed font-bold">Nincs leírás.</p>
            </div>
            <div id="info-action-container" class="mt-4"></div>
        </div>

        <!-- HOZZÁADÁS -->
        <div id="view-add" class="view hidden p-8 max-w-xl mx-auto">
            <button onclick="window.showView('view-map')" class="text-[10px] text-gray-500 font-bold mb-8 uppercase">← Mégse</button>
            <h2 class="text-3xl font-bold text-green-500 mb-8 italic uppercase">Új Pont</h2>
            <form onsubmit="window.saveLocation(event)" class="space-y-6">
                <input id="loc-name" required type="text" placeholder="Helyszín neve" class="w-full p-4 rounded-xl bg-black border border-gray-800 text-white font-bold uppercase outline-none focus:border-green-500">
                <select id="loc-category-select" class="w-full p-4 rounded-xl bg-black border border-gray-800 text-white uppercase outline-none"></select>
                <select id="loc-group-select" class="w-full p-4 rounded-xl bg-black border border-gray-800 text-white uppercase outline-none"></select>
                <textarea id="loc-approach" required rows="3" placeholder="Bejutási útvonal és leírás..." class="w-full p-4 rounded-xl bg-black border border-gray-800 text-white outline-none focus:border-green-500"></textarea>
                <button type="submit" class="w-full bg-green-600 text-black font-bold py-5 rounded-2xl text-sm uppercase shadow-2xl tracking-widest">Beküldés</button>
            </form>
        </div>
    </main>

    <!-- NAVIGÁCIÓ -->
    <nav class="fixed bottom-0 inset-x-0 bg-black/95 backdrop-blur-2xl border-t border-gray-800 p-2 pb-6 z-[6000]">
        <div class="max-w-xl mx-auto flex justify-around items-end">
            <button onclick="window.showView('view-map')" class="flex-1 flex flex-col items-center gap-1 active:scale-90">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span class="text-[8px] font-bold text-gray-500 uppercase">Térkép</span>
            </button>
            <button id="checkin-btn-outer" onclick="window.handleAction()" class="hidden bg-green-600 p-5 rounded-full -mt-10 border-[6px] border-black shadow-2xl active:scale-95 opacity-40">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </button>
            <button onclick="window.showView('view-groups')" class="flex-1 flex flex-col items-center gap-1 active:scale-90">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span class="text-[8px] font-bold text-gray-500 uppercase">Klánok</span>
            </button>
            <button id="nav-login-section" onclick="window.loginWithGoogle()" class="flex-1 flex flex-col items-center gap-1">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span class="text-[8px] font-bold text-gray-500 uppercase">Belépés</span>
            </button>
            <button id="nav-logout-section" onclick="window.logout()" class="hidden flex-1 flex flex-col items-center gap-1">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red-500"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="text-[8px] font-bold text-red-500 uppercase">Kilépés</span>
            </button>
        </div>
    </nav>
</body>
</html>
