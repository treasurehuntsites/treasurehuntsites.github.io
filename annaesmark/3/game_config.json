{"CONFIG_VERSION":"3.2","LAST_EDITED_INDEX":20,"APP_TITLE":"Anna és Márk Kincskeresés (Alapértelmezett)","BACKGROUND_URL":"Img/oszlop.jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=16sa3cYL_ieEYMSaDIKcfMoa4IgTnFgM&ll=47.47261249999998%2C19.040140200000003&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.47362,"TARGET_LONGITUDE":19.04489,"SUCCESS_REDIRECT_URL":"https://treasurehuntsites.github.io/annaesmark/4/game.html","MAP_BUTTON_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1kog8MDXujLYhzemX4egMSUcmHlDfZ2E&ll=47.473625900000016%2C19.044898400000015&z=17"},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/annaesmark/Img/mark.png","§A":"https://treasurehuntsites.github.io/annaesmark/Img/anna.png","§R":"https://placehold.co/70x70/1A1A1A/00FF00?text=R"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":"§M Szép munka volt Anna! ","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/oszlop.jpg","galleryMode":"add_url"},{"type":"text","content":"§A Köszi Márk!","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A És most hogyan tovább?\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"choice","content":"§N ","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url","choices":[{"text":"Körülnéztek az oszlop környékén","nextIndex":4}]},{"type":"text","content":"§N A rozoga oszlopon lévő szám, évtizedek óta ott rozsdásodott a Kosztolányi Dezső tér egyik félreeső sarkában.","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Látszólag nem volt jelentősége, mégis, amikor Anna és Márk egy kellemes őszi délután a téren sétálva megpillantották, valami furcsa érzés fogta el őket.","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N A szám szinte hívogatta őket, hogy felfedjék a történetét.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Miért van egy szám egy oszlopon? Ráadásul ilyen nagy? – töprengett Márk, miközben megérintette az oszlop fáját.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Lehet, hogy csak egy régi azonosító, talán a villamosvonalhoz tartozott – válaszolt Anna, aki történészként mindig szeretett felfedezni elfeledett részleteket a város múltjából.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Ahogy közelebbről megnézték az oszlopot, Anna észrevett egy finom, alig látható karcolást a szám alatt.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N A fa mélyén egy nyíl formájú jel látszott, amely lefelé mutatott.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Ez itt biztos nem véletlen – mondta Márk, és a nyíl irányát követve az oszlop tövében egy apró fémlapot találtak a földbe ágyazva.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N A fémlapra egyetlen szót véstek: „Kövess.”\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Ez egy játék? – kérdezte Márk, izgatottság csillogott a szemében.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Vagy talán valami több. Nézzük meg, hová vezet – felelte Anna.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N A fémlapon még egy nyíl látszott, amely az egyik közeli járdaszegély felé mutatott.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Anna és Márk elindultak, követve a nyílakat.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N A nyomok egy elhagyatott, omladozó épülethez vezettek, amelyről Anna azonnal tudta, hogy egy régi villamoskarbantartó műhely lehetett.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Az épület ajtaján egy rozsdás számzáras lakat lógott.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Ez túl egyszerű – jegyezte meg Márk.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"password","content":"§N ","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url","correctPassword":"26690","nextIndexSuccess":-1,"helpMessage":["5 jegyű szám"]}],"MEDIA":{"AUDIO_1_URL":"https://treasurehuntsites.github.io/media/Ugynokok1.mp3","AUDIO_2_URL":"https://treasurehuntsites.github.io/media/Ugynokok2.mp3"}}