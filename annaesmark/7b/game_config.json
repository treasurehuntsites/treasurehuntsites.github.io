{"CONFIG_VERSION":"3.2","LAST_EDITED_INDEX":0,"APP_TITLE":"Anna és Márk - Eötvös József kollégium","BACKGROUND_URL":"https://treasurehuntsites.github.io/annaesmark/7/Img/kollegium.jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1kaCDXQuDanjb9bhXid-kGnC7G_oUK6s&ll=47.47979090000001%2C19.046269300000013&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.480414,"TARGET_LONGITUDE":19.038478,"SUCCESS_REDIRECT_URL":"https://treasurehuntsites.github.io/annaesmark/8/game.html","MAP_BUTTON_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1U4YluhIrmQvjlCG7Zz1WuJjAxIj2IE8&ll=47.48042360000002%2C19.03847879999999&z=17"},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/annaesmark/Img/mark.png","§A":"https://treasurehuntsites.github.io/annaesmark/Img/anna.png","§R":"https://placehold.co/70x70/1A1A1A/00FF00?text=R"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":"§N Az alagút falai tele voltak régi freskókkal, térképekkel és írásokkal, amelyek egy elveszett kincsre és egy titkos küldetésre utaltak. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/kollegium.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Egy rozoga asztalon egy régi, kopott naplót találtak, amely az utolsó oldalán ezt írta:\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Aki ezt megtalálja, őrködjön a titok felett. Az igazság veszélyes lehet. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/aki.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A jövőben majd két ügynők, itt találja mit keres, végső zárhoz nyitó kódot egy egy öt egyet.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§A Ez olyan, mintha valami filmet néznénk. De mi az igazság?","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§M Lehet, hogy sosem tudjuk meg. Nekünk a küldetésünkkel kell foglalkozni, ez most mindennél fontosabb. Talán még visszatérünk ide.","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Lilla és Péter történetüket nem mesélték el senkinek, de a falra vésett számok továbbra is ott álltak. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N Azóta több diák is hallott furcsa hangokat a déli szárny közelében, és mindenki tudni véli, hogy valami különös rejlik a kollégium múltjában. De csak Zsófi és barátai tudják, hogy a valódi rejtély még mindig a mélyben vár.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"§N ...És most már Anna és Márk is.","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"password","content":"§N ","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url","correctPassword":"1151","nextIndexSuccess":-1,"helpMessage":["Nézd meg a jegyzeteid között az utolsó papírlapot","1151"]}],"MEDIA":{"AUDIO_1_URL":"Img/hang.mp3","AUDIO_2_URL":"https://treasurehuntsites.github.io/media/Ugynokok2.mp3"}}