{"CONFIG_VERSION":"3.8","LAST_EDITED_INDEX":6,"APP_TITLE":"Könyvmegálló","BACKGROUND_URL":"https://treasurehuntsites.github.io/konyvmegallo/6/Img/kereszt.jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1svp-OuzNyNKwKQ-W_QOk0mz_27Rob0E&ll=47.47897%2C19.04066690000002&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.47871,"TARGET_LONGITUDE":19.04037,"SUCCESS_REDIRECT_URL":"https://treasurehuntsites.github.io/konyvmegallo/7/game.html","MAP_BUTTON_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1kUg9XWFl5L4H24wX-le2haDMLGTuM1Y&ll=47.47871259999998%2C19.040377199999988&z=17"},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/annaesmark/Img/mark.png","§A":"https://treasurehuntsites.github.io/annaesmark/Img/anna.png","§R":"Img/rendor.png"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":" §A Fú, ez meleg helyzet volt!... Nézd, a rendőr zsebéből kiesett valami!","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Az Emericus Sportcsarnok új épülete modern acél- és üvegfalakkal hirdette a környék fejlődését. Az éjszakai fényekben ragyogott, és egészen futurisztikus hangulatot árasztott.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Anna és Márk a csarnok oldalfalát vizsgálták, amelyen egy hatalmas, díszes kereszt volt felfestve. Az iránytű-szerű kereszt közepén egy gólya állt, csőrében valamivel, amit nem láttak jól.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg","galleryMode":"add_url"},{"type":"text","content":"§A Ez lenne a gólya, ami az irányt mutatja? - mondta Anna, miközben megvizsgálta az ábrát. - De ezek betűk... mit jelentenek?","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg","galleryMode":"add_url"},{"type":"text","content":"§M Márk kimeresztette a szemét , és a betűket vizsgálta.\n— Nem az égtájak. És nem is véletlen sorrend. Talán Sándor nyomai? ","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg","galleryMode":"add_url"},{"type":"text","content":"§A Lehet, hogy köze van a rendőr-ügynök zsebéből kiesett papaírcetlihez? Hogyan tudnánk tovább jutni?","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg","galleryMode":"add_url"},{"type":"password","content":"§A Lehet, hogy köze van a rendőr-ügynök zsebéből kiesett papaírcetlihez? Hogyan tudnánk tovább jutni?","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/nesnesw.jpg\nImg/kereszt.jpg","galleryMode":"add_url","correctPassword":"mormors","nextIndexSuccess":-1,"helpMessage":["Égtájak","olvasd el a kereszt betűit az égtájak szerint","mormors"]}],"MEDIA":{"AUDIO_1_URL":"https://treasurehuntsites.github.io/konyvmegallo/3/Img/audio1.mp3","AUDIO_2_URL":"https://treasurehuntsites.github.io/konyvmegallo/3/Img/audio2.mp3"}}