{"CONFIG_VERSION":"3.8","LAST_EDITED_INDEX":28,"APP_TITLE":"Könyvmegálló - Mormors","BACKGROUND_URL":"https://treasurehuntsites.github.io/konyvmegallo/8/Img/titkosdoboz.jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1XGmzt8LMckLzxREbQC1JkFTrDKPDEW8&ll=47.48091320000002%2C19.03810299999999&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.47469,"TARGET_LONGITUDE":19.03633,"SUCCESS_REDIRECT_URL":"https://goo.gl/maps/RVNTKULSiVMahYHg9?g_st=ac","MAP_BUTTON_URL":"https://goo.gl/maps/RVNTKULSiVMahYHg9?g_st=ac"},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/annaesmark/Img/mark.png","§A":"https://treasurehuntsites.github.io/annaesmark/Img/anna.png","§R":"https://placehold.co/70x70/1A1A1A/00FF00?text=R"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":"§N A dobozban egy apró cetlit találtak, rajta egyetlen kóddal. Alatta pedig egy üzenet állt:\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Alatta pedig egy üzenet állt:\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N \"Az igazság mindent megtisztít. Az árulók árnyai többé nem kísértenek\"\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§A Anna döbbenten nézett a helyszínre. — Ennyi volt? Csak egy kód miatt voltak itt?\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§M Márk a zsebébe tette a cetlit, majd megrázta a fejét.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§M Márk a zsebébe tette a cetlit, majd megrázta a fejét.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§M Nem a kód miatt voltak itt. A mormorok a múlt bűneinek árnyai.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§M Valaki nagyon súlyos dolgot követett el itt, és ezek a lények ezért jelentek meg. ","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§M De most, hogy az igazságot keressük, eltűnnek.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Az utolsó nyomok visszavezettek a könyves  szekrényhez. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A könyvek mögött ott rejtőzött a végső számzáras doboz.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Márk óvatosan betekerte a kódot.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Márk óvatosan betekerte a kódot.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A doboz halk kattanással kinyílt.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A számzáras ládikóban egy papírt találtak, amin Emericus neve szerepelt, mint áruló. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Mellette az árulásért kapott jutalma, ami mostmár Annát és Márkot illette. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A könyves szekrény alsó polcán egy régi jegyzetfüzetet is találtak.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A fedlapján ez állt: \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N \"Emericus Sándor: Az árulás naplója\"\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Anna és Márk döbbenten laoozták végig. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A füzetben részletes beszámoló állt a Feneketlen-tó partján történt árulásról. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Kiderült, hogy Sándor nem áldozat volt, hanem maga az áruló, aki eladta társait az ellenségnek.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Azonban amikor felismerte mit tett, elrejtette a bizonyítékokat, hogy senki ne találja meg.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§A Tehát ő idézte elő a mormorokat - mondta Anna halkan - Az árulás árnyai soha nem hagyták őt békén.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Márk becsukta a füzetet és becsúsztatta a szekrény leghátsó sarkába.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N De most végre vége. Az igazság napvilágra került. \n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Talán mostmár a múlt is nyugovóra térhet.\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N Ahogy elindultak a kis úton, ami a szekrénytől elfele vezetett, az első napugarak lassan áttörtél az éjszaka sötétjét.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg","galleryMode":"add_url"},{"type":"text","content":"§N A küldetésük véget ért, de a történetüket még sokáig meséli fogják. - A kémek történetét, akik szembenéztek a múlt sötét árnyaival, és végül győztek.\n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/1357.jpg\nImg/titkosdoboz.jpg","galleryMode":"add_url","backIndex":-1}],"MEDIA":{"AUDIO_1_URL":"https://treasurehuntsites.github.io/media/mormors.mp3","AUDIO_2_URL":"https://treasurehuntsites.github.io/media/Ugynokok2.mp3"}}