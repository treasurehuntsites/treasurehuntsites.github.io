{"CONFIG_VERSION":"3.8","LAST_EDITED_INDEX":10,"APP_TITLE":"Anna és Márk Kincskeresés (Alapértelmezett)","BACKGROUND_URL":"https://treasurehuntsites.github.io/konyvmegallo/3/Img/fulke.jpg","BODY_BG_COLOR":"#1a1a1a","BODY_TEXT_COLOR":"#e0e0e0","MENU_LINKS":{"MAP_LINK_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1Tio31y-lfe-2a6aG9SYitDtRJGAnAPs&ll=47.47501210000002%2C19.039103200000014&z=17"},"GPS_COMPASS":{"TARGET_LATITUDE":47.47501,"TARGET_LONGITUDE":19.0391,"SUCCESS_REDIRECT_URL":"3b/game.html","MAP_BUTTON_URL":"https://www.google.com/maps/d/u/0/viewer?mid=1Tio31y-lfe-2a6aG9SYitDtRJGAnAPs&ll=47.47501210000002%2C19.039103200000014&z=17"},"PASSWORD_PAGE":{"PROMPT_TEXT":"Add meg a kódot:","CHECK_BUTTON_TEXT":"ELLENŐRZÉS","BACK_BUTTON_TEXT":"Vissza","ERROR_MESSAGE":"Helytelen jelszó! Próbáld újra.","SUCCESS_MESSAGE":"Kód elfogadva!"},"AVATARS":{"DEFAULT_AVATAR_URL":"https://placehold.co/70x70/1A1A1A/FFFFFF?text=?","AVATAR_MAP":{"§M":"https://treasurehuntsites.github.io/annaesmark/Img/mark.png","§A":"https://treasurehuntsites.github.io/annaesmark/Img/anna.png","§R":"https://placehold.co/70x70/1A1A1A/00FF00?text=R"},"HIDDEN_PREFIXES":["§N","§KOD","§H","§RESET"]},"storyPages":[{"type":"text","content":"Szép munka Ügynökök. Nyomozzátok ki, hogy mi történhetett.\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"Img/fulke.jpg","galleryMode":"add_url"},{"type":"text","content":"A rádióadót pedig hozzátok el az ügynökségre, odaadjuk az elemző részlegnek.\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Most, hogy tudjátok a feladatot, induljatok el  a Bartók Béla úton.\n\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Keressetek egy dohány boltot. Előtte van egy telefonfülke.\n\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Van benne egy kis üvegfiola. Azt kell megszerezni.\n\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Vigyázzatok, mert a telefonfülkét figyelik. Ha valamelyikőtök bemegy, később követni fogják.\n\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Ezért azt javaslom, hogy hívjátok fel a fülkét és kérjétek meg aki felveszi a telefont, hogy keresse meg az üvegcsét és olvassa be a kódot.\n\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Az üzenet egy üveg fiolában van elrejtve, mágnessel rögzítve a telefonfülkében.\n\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url"},{"type":"text","content":"Hogy mégjobban álcázzátok magatokat, küldök egy hang filet, azt játszátok be a telefonba. Így a hangotok sem ismerheti fel utána senki.\n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"Img/telefonszam.png\nImg/telefon.png","galleryMode":"add_url"},{"type":"audio","content":"§N \n\n","customAvatarUrl":"Img/telo.jpg","customBackgroundUrl":"","customGalleryUrl":"Img/telefonszam.png\nImg/telefon.png","galleryMode":"add_url","audioId":1},{"type":"audio","content":"§N ","customAvatarUrl":"Img/telefon.png","customBackgroundUrl":"","customGalleryUrl":"","galleryMode":"add_url","audioId":2},{"type":"password","content":"§N \n\n","customAvatarUrl":"","customBackgroundUrl":"","customGalleryUrl":"Img/telefonszam.png\nImg/telefon.png","galleryMode":"add_url","correctPassword":"8062","nextIndexSuccess":-1,"helpMessage":["fej felett, üvegkapszula","a telefon telefonszámának utolsó 4 számjegye","8062"]}],"MEDIA":{"AUDIO_1_URL":"https://treasurehuntsites.github.io/konyvmegallo/3/Img/audio1.mp3","AUDIO_2_URL":"https://treasurehuntsites.github.io/konyvmegallo/3/Img/audio2.mp3"}}
